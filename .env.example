# AI Sales Intelligence Platform — Environment Configuration

# ===== Database Configuration =====
# Backend storage: "postgres" (production) or "duckdb" (development/testing)
DB_TYPE=postgres

# PostgreSQL connection (used when DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=sales_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# DuckDB file location (used when DB_TYPE=duckdb; optional, defaults to db/sales_intel.duckdb)
DUCKDB_PATH=db/sales_intel.duckdb

# ===== LLM Configuration =====
# LLM client: "mock" for testing/dev (no API key needed), "anthropic" for production
LLM_CLIENT=mock

# Anthropic API key (required when LLM_CLIENT=anthropic)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model IDs (must use exact model IDs for cost tracking)
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-5-20251022

# ===== Data Paths =====
# Path to raw Shodan scan data file (zstd-compressed JSONL)
# Leave commented out to use default: data/raw/shodan_scan.jsonl.zst
# RAW_DATA_PATH=

# Traces/telemetry log location (optional, defaults to traces/llm_traces.jsonl)
TRACES_JSONL_PATH=traces/llm_traces.jsonl

# ===== Scoring Configuration =====
# Risk scoring model version (e.g., "v1", "v2") — used for reproducibility & traceability
SCORE_VERSION=v1

# Weights model version (composite score weights)
WEIGHTS_VERSION=v1

# ===== Enrichment Configuration =====
# Default number of top accounts to enrich per run
DEFAULT_TOP_N=50

# Maximum accounts to enrich in a single run (cost control for LLM usage)
MAX_ACCOUNTS_PER_ENRICHMENT=1000

# ===== Pipeline Configuration =====
# Batch size for ingestion (records processed at a time)
BATCH_SIZE=5000

# Limit total records ingested (useful for dev iteration)
# Leave commented out to ingest all records
# Uncomment and set to a number (e.g., 50000) for faster dev iteration
# MAX_RECORDS_TO_INGEST=50000

# ===== Logging & Observability =====
# Enable Logfire instrumentation (FastAPI, system metrics, LLM tracing)
LOGFIRE_ENABLED=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logfire cloud token (optional; for exporting traces to Logfire cloud dashboard)
# Get from: https://logfire.pydantic.dev/
# Leave empty to use local-only Logfire logging
LOGFIRE_TOKEN=

# ===== Environment =====
# Environment mode: "development" or "production"
# Controls safety checks and feature toggles
ENVIRONMENT=development
