# AI Sales Intelligence Platform — Environment Configuration

# ===== LLM Configuration =====
# LLM client to use: "mock" for testing/dev (no API key needed), "anthropic" for production
LLM_CLIENT=mock

# Anthropic API key (required when LLM_CLIENT=anthropic)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== Paths =====
# Path to the raw Shodan scan data file (zstd-compressed JSONL)
RAW_DATA_PATH=/path/to/shodan_scan.jsonl.zst

# DuckDB file location (optional, defaults to db/sales_intel.duckdb)
DUCKDB_PATH=db/sales_intel.duckdb

# Traces/telemetry log location (optional, defaults to traces/llm_traces.jsonl)
TRACES_JSONL_PATH=traces/llm_traces.jsonl

# ===== Scoring Configuration =====
# Scoring model version (e.g., "v1", "v2") — used for traceability
SCORE_VERSION=v1

# Weights model version
WEIGHTS_VERSION=v1

# ===== Enrichment Configuration =====
# Default number of top accounts to enrich per run
DEFAULT_TOP_N=50

# Maximum accounts to enrich in a single run (cost control)
MAX_ACCOUNTS_PER_ENRICHMENT=1000

# ===== Pipeline Configuration =====
# Batch size for ingestion (records at a time)
BATCH_SIZE=5000

# Limit total records ingested (useful for dev iteration; None = all records)
MAX_RECORDS_TO_INGEST=

# ===== Logging =====
# Enable Logfire instrumentation
LOGFIRE_ENABLED=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logfire token (optional, for cloud telemetry export)
# Get from: https://logfire.pydantic.dev/
# LOGFIRE_TOKEN=

# ===== Development =====
# Set to "development" to disable some production safeguards
ENVIRONMENT=development
